# Duong dan tuyet doi tren VM2. SPARK_V1_ENV_FILE tro ve ban rieng cua file nay.
SPARK_V1_ENV_FILE=/home/hduser/.env.v1-spark
SPARK_V1_JARS_DIR=/home/hduser/.ivy2/jars
SPARK_V1_CHECKPOINTS_DIR=/home/hduser/news-spark/checkpoints

MINIO_ENDPOINT=http://192.168.1.195:9000
MINIO_BUCKET=vn-news-lake
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KAFKA_BOOTSTRAP=192.168.1.195:9092
POLARIS_URI=http://192.168.1.195:8181/api/catalog
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

# Chi bat khi khoi tao pipeline moi voi checkpoint chua ton tai.
SPARK_V1_ALLOW_NEW_CHECKPOINT=0
